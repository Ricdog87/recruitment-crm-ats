# Database
DATABASE_URL="postgresql://user:password@localhost:5432/recruitment_crm"

# LinkedIn API
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token

# StepStone API
STEPSTONE_API_KEY=your_api_key
STEPSTONE_API_SECRET=your_api_secret

# Indeed API
INDEED_PUBLISHER_ID=your_publisher_id
INDEED_API_TOKEN=your_api_token

# HR4you CRM
HR4YOU_API_URL=https://your-instance.hr4you.com/api
HR4YOU_API_KEY=your_api_key

# Advertsdata Scraper
ADVERTSDATA_URL=https://db.advertsdata.com/anzeigendaten/index.cfm
ADVERTSDATA_USERNAME=your_username
ADVERTSDATA_PASSWORD=your_password

# OpenAI for NLP/Matching
OPENAI_API_KEY=your_openai_key

# n8n Webhooks
N8N_WEBHOOK_URL=http://your-server:5678/webhook

# App Config
PORT=3000
NODE_ENV=development
