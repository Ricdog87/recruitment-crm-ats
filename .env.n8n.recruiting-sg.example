# ================================================
# n8n Environment Variables - recruiting-sg.com Production
# ================================================
# Copy this file to your n8n environment
# All workflows are configured for recruiting-sg.com deployment
# ================================================

# CRM Backend Configuration - recruiting-sg.com
CRM_API_URL=https://recruiting-sg.com/api
CRM_USER_EMAIL=admin@example.com
CRM_USER_PASSWORD=password123
CRM_TEAM_ID=your-team-id-from-crm

# Index Recruiting Platform
INDEX_API_URL=https://api.index-recruiting.com
INDEX_API_KEY=your-index-api-key

# Apollo.io (Contact Enrichment)
APOLLO_API_KEY=your-apollo-io-api-key

# Mailgun (Email Notifications)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.recruiting-sg.com
MAILGUN_FROM_EMAIL=crm@recruiting-sg.com
NOTIFICATION_EMAIL=team@recruiting-sg.com

# Google Sheets (KPI Dashboard)
GOOGLE_SHEET_ID=your-google-sheet-id
# Note: Google Sheets OAuth2 credentials are configured in n8n UI

# HubSpot (Migration)
HUBSPOT_API_KEY=your-hubspot-api-key
# Note: HubSpot OAuth2 credentials are configured in n8n UI

# Redis (Token Storage)
# Use internal Docker network name if n8n is on same Docker network
REDIS_HOST=crm-ats-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_USE_REDIS_PASSWORD_FROM_DEPLOYMENT
REDIS_DB=0

# n8n Configuration (if applicable)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-n8n-password
N8N_HOST=recruiting-sg.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# Webhook URLs (auto-generated by n8n)
# If n8n is on same VPS, use your n8n domain
WEBHOOK_URL=https://your-n8n-domain.com/webhook
WEBHOOK_TEST_URL=https://your-n8n-domain.com/webhook-test

# Optional: Timezone
TZ=Europe/Berlin

# Optional: Execution Settings
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Optional: Performance
N8N_PAYLOAD_SIZE_MAX=16
EXECUTIONS_TIMEOUT=600
EXECUTIONS_TIMEOUT_MAX=3600

# ================================================
# DEPLOYMENT CREDENTIALS
# ================================================
# After running deploy-traefik.sh, update these:
#
# REDIS_PASSWORD: Copy from deployment output
# CRM_TEAM_ID: Get via API after login
#
# To get team ID:
# 1. Login: curl -X POST https://recruiting-sg.com/api/auth/login \
#      -H "Content-Type: application/json" \
#      -d '{"email":"admin@example.com","password":"password123"}'
#
# 2. Get user info: curl https://recruiting-sg.com/api/auth/me \
#      -H "Authorization: Bearer <access_token>"
#
# 3. Extract team_memberships[0].team_id from response
# ================================================
