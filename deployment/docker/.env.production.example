# Database Configuration
DB_USER=crm_ats_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
DB_NAME=recruitment_crm_ats

# JWT Secrets (MUST be changed in production!)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGINS=https://crm.rsg-recruiting.de,https://www.rsg-recruiting.de

# Optional: Email Configuration (for future features)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=noreply@rsg-recruiting.de
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=RSG Recruiting <noreply@rsg-recruiting.de>

# Optional: S3/Object Storage (for document uploads)
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=crm-ats-documents
