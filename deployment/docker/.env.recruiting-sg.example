# ==============================================================================
# PRODUCTION ENVIRONMENT - recruiting-sg.com
# ==============================================================================
# Copy this file to .env and fill in all values
# DO NOT commit the .env file to version control!
#
# Generate secure secrets with: openssl rand -base64 48
# ==============================================================================

# Database Configuration
DB_USER=crm_ats_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
DB_NAME=recruitment_crm_ats

# Redis Configuration (for n8n workflows)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS

# JWT Secrets (MUST be changed in production!)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
# Add all domains that should be allowed to access the API
CORS_ORIGINS=https://recruiting-sg.com,https://www.recruiting-sg.com

# ==============================================================================
# OPTIONAL CONFIGURATIONS
# ==============================================================================

# Email Configuration (for future features)
# SMTP_HOST=smtp.recruiting-sg.com
# SMTP_PORT=587
# SMTP_USER=noreply@recruiting-sg.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=Recruiting SG <noreply@recruiting-sg.com>

# S3/Object Storage (for document uploads)
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=crm-ats-documents

# Monitoring & Logging
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=info

# ==============================================================================
# QUICK SETUP COMMANDS
# ==============================================================================
#
# 1. Copy this file:
#    cp .env.recruiting-sg.example .env
#
# 2. Generate secrets:
#    echo "DB_PASSWORD=$(openssl rand -base64 32)"
#    echo "REDIS_PASSWORD=$(openssl rand -base64 32)"
#    echo "JWT_SECRET=$(openssl rand -base64 48)"
#    echo "JWT_REFRESH_SECRET=$(openssl rand -base64 48)"
#
# 3. Edit .env and replace all CHANGE_ME values
#
# 4. Secure the .env file:
#    chmod 600 .env
#
# ==============================================================================
