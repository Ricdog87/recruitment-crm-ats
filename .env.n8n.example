# ================================================
# n8n Environment Variables for CRM Integration
# ================================================

# CRM Backend Configuration
CRM_API_URL=https://crm.rsg-recruiting.de
CRM_USER_EMAIL=your-crm-admin@rsg-recruiting.de
CRM_USER_PASSWORD=your-secure-crm-password
CRM_TEAM_ID=your-team-id-from-crm

# Index Recruiting Platform
INDEX_API_URL=https://api.index-recruiting.com
INDEX_API_KEY=your-index-api-key

# Apollo.io (Contact Enrichment)
APOLLO_API_KEY=your-apollo-io-api-key

# Mailgun (Email Notifications)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.rsg-recruiting.de
MAILGUN_FROM_EMAIL=crm@rsg-recruiting.de
NOTIFICATION_EMAIL=team@rsg-recruiting.de

# Google Sheets (KPI Dashboard)
GOOGLE_SHEET_ID=your-google-sheet-id
# Note: Google Sheets OAuth2 credentials are configured in n8n UI

# HubSpot (Migration)
HUBSPOT_API_KEY=your-hubspot-api-key
# Note: HubSpot OAuth2 credentials are configured in n8n UI

# Redis (Token Storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# n8n Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-n8n-password
N8N_HOST=n8n.rsg-recruiting.de
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# Webhook URLs (auto-generated by n8n)
WEBHOOK_URL=https://n8n.rsg-recruiting.de/webhook
WEBHOOK_TEST_URL=https://n8n.rsg-recruiting.de/webhook-test

# Optional: Timezone
TZ=Europe/Berlin

# Optional: Execution Settings
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Optional: Performance
N8N_PAYLOAD_SIZE_MAX=16
EXECUTIONS_TIMEOUT=600
EXECUTIONS_TIMEOUT_MAX=3600
