{
  "name": "CRM Authentication & Token Management",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.CRM_API_URL}}/api/auth/login",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{$env.CRM_USER_EMAIL}}"
            },
            {
              "name": "password",
              "value": "={{$env.CRM_USER_PASSWORD}}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Login to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "crm_access_token",
        "value": "={{$json.access_token}}",
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Store Access Token",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "operation": "set",
        "key": "crm_refresh_token",
        "value": "={{$json.refresh_token}}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Store Refresh Token",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [680, 480],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "operation": "expire",
        "key": "crm_access_token",
        "seconds": "={{7 * 24 * 60 * 60}}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Set Token Expiry (7 days)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.access_token}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Check Login Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 480]
    },
    {
      "parameters": {
        "message": "=✅ CRM Authentication successful!\nAccess Token: {{$json.access_token.substring(0, 20)}}...\nToken stored in Redis with 7-day expiry."
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Success Notification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "message": "=❌ CRM Authentication failed!\nPlease check your credentials in environment variables."
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Error Notification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 660]
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [
        [
          {
            "node": "Login to CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Login to CRM": {
      "main": [
        [
          {
            "node": "Check Login Success",
            "type": "main",
            "index": 0
          },
          {
            "node": "Store Access Token",
            "type": "main",
            "index": 0
          },
          {
            "node": "Store Refresh Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Access Token": {
      "main": [
        [
          {
            "node": "Set Token Expiry (7 days)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Token Expiry (7 days)": {
      "main": [
        [
          {
            "node": "Success Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Login Success": {
      "main": [
        [],
        [
          {
            "node": "Error Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "CRM",
      "id": "crm-auth"
    }
  ],
  "meta": {
    "instanceId": "crm-recruiting-ats"
  },
  "pinData": {},
  "versionId": "1.0.0"
}
