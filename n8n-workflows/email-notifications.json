    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.data);\n\nconst emailBody = `\n<h2>🎯 Candidate Submitted to Project</h2>\n\n<p><b>Project:</b> ${data.project_title}</p>\n<p><b>Candidate:</b> ${data.candidate_name}</p>\n<p><b>Email:</b> ${data.candidate_email}</p>\n<p><b>Match Score:</b> ${data.match_score}/100</p>\n<p><b>Submitted by:</b> ${data.submitted_by}</p>\n<p><b>Date:</b> ${new Date().toLocaleDateString('de-DE')}</p>\n\n<hr>\n\n<p><b>Candidate Profile:</b></p>\n<ul>\n  <li>Seniority: ${data.seniority || 'N/A'}</li>\n  <li>Location: ${data.plz || 'N/A'}</li>\n  <li>Salary Expectation: ${data.salary_expectation ? '€' + data.salary_expectation.toLocaleString() : 'N/A'}</li>\n</ul>\n\n<p><a href=\"${process.env.CRM_API_URL}/api/submissions/${data.submission_id}\">View Submission in CRM</a></p>\n`;\n\nreturn [{\n  json: {\n    to: $json.recipient_email,\n    subject: `🎯 New Candidate Submitted: ${data.candidate_name} for ${data.project_title}`,\n    html: emailBody\n  }\n}];"
      },
      "id": "e1b2c3d4-0004-0004-0004-000000000004",
      "name": "Template: Candidate Submitted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.data);\n\nconst emailBody = `\n<h2>📅 Interview Scheduled</h2>\n\n<p><b>Project:</b> ${data.project_title}</p>\n<p><b>Candidate:</b> ${data.candidate_name}</p>\n<p><b>Interview Date:</b> ${new Date(data.interview_date).toLocaleString('de-DE')}</p>\n<p><b>Interview Type:</b> ${data.interview_type || 'Standard Interview'}</p>\n<p><b>Location/Link:</b> ${data.interview_location || data.interview_link || 'TBD'}</p>\n\n<hr>\n\n<p><b>Preparation Notes:</b></p>\n<p>${data.notes || 'No additional notes'}</p>\n\n<p><a href=\"${process.env.CRM_API_URL}/api/submissions/${data.submission_id}\">View Details in CRM</a></p>\n`;\n\nreturn [{\n  json: {\n    to: $json.recipient_email,\n    subject: `📅 Interview Scheduled: ${data.candidate_name} - ${new Date(data.interview_date).toLocaleDateString('de-DE')}`,\n    html: emailBody\n  }\n}];"
      },
      "id": "e1b2c3d4-0005-0005-0005-000000000005",
      "name": "Template: Interview Scheduled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 350]
    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.data);\n\nconst emailBody = `\n<h2>💼 Job Offer Sent</h2>\n\n<p><b>Congratulations!</b> An offer has been sent to:</p>\n\n<p><b>Candidate:</b> ${data.candidate_name}</p>\n<p><b>Project:</b> ${data.project_title}</p>\n<p><b>Offer Details:</b></p>\n<ul>\n  <li>Salary: €${data.offer_salary ? data.offer_salary.toLocaleString() : 'Confidential'}</li>\n  <li>Start Date: ${data.start_date ? new Date(data.start_date).toLocaleDateString('de-DE') : 'TBD'}</li>\n  <li>Contract Type: ${data.contract_type || 'Permanent'}</li>\n</ul>\n\n<p><b>Next Steps:</b></p>\n<p>${data.next_steps || 'Awaiting candidate response'}</p>\n\n<p><a href=\"${process.env.CRM_API_URL}/api/submissions/${data.submission_id}\">Track Offer Status in CRM</a></p>\n`;\n\nreturn [{\n  json: {\n    to: $json.recipient_email,\n    subject: `💼 Offer Sent to ${data.candidate_name} for ${data.project_title}`,\n    html: emailBody\n  }\n}];"
      },
      "id": "e1b2c3d4-0006-0006-0006-000000000006",
      "name": "Template: Offer Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 500]
    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.data);\n\nconst emailBody = `\n<h2>🎉 Candidate Hired - Placement Success!</h2>\n\n<p><b>Excellent news!</b> We've successfully placed a candidate:</p>\n\n<p><b>Candidate:</b> ${data.candidate_name}</p>\n<p><b>Project:</b> ${data.project_title}</p>\n<p><b>Company:</b> ${data.company_name}</p>\n<p><b>Start Date:</b> ${data.start_date ? new Date(data.start_date).toLocaleDateString('de-DE') : 'TBD'}</p>\n<p><b>Placement Fee:</b> ${data.placement_fee ? '€' + data.placement_fee.toLocaleString() : 'TBD'}</p>\n\n<hr>\n\n<p><b>Recruitment Timeline:</b></p>\n<ul>\n  <li>Days to Hire: ${data.days_to_hire || 'N/A'}</li>\n  <li>Submissions: ${data.total_submissions || 'N/A'}</li>\n  <li>Interviews: ${data.total_interviews || 'N/A'}</li>\n</ul>\n\n<p><b>Congratulations to the team! 🎊</b></p>\n\n<p><a href=\"${process.env.CRM_API_URL}/api/submissions/${data.submission_id}\">View Placement Details in CRM</a></p>\n`;\n\nreturn [{\n  json: {\n    to: $json.recipient_email,\n    subject: `🎉 Placement Success: ${data.candidate_name} hired for ${data.project_title}`,\n    html: emailBody\n  }\n}];"
      },
      "id": "e1b2c3d4-0007-0007-0007-000000000007",
      "name": "Template: Candidate Hired",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 650]
