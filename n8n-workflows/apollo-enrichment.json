{
  "name": "Apollo.io Contact Enrichment",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "c1b2c3d4-0001-0001-0001-000000000001",
      "name": "Every 4 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "crm_access_token"
      },
      "id": "c1b2c3d4-0002-0002-0002-000000000002",
      "name": "Get CRM Token",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.CRM_API_URL}}/api/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "team_id",
              "value": "={{$env.CRM_TEAM_ID}}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('Get CRM Token').first().json}}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-0003-0003-000000000003",
      "name": "Get Contacts from CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.email}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$json.phone}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "c1b2c3d4-0004-0004-0004-000000000004",
      "name": "Filter: Missing Phone",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "https://api.apollo.io/v1/people/match",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "apolloApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{$json.email}}"
            },
            {
              "name": "first_name",
              "value": "={{$json.first_name}}"
            },
            {
              "name": "last_name",
              "value": "={{$json.last_name}}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-0005-0005-0005-000000000005",
      "name": "Apollo.io Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "jsCode": "const apolloData = $json.person || {};\nconst crmContact = $input.first().json;\n\nconst enriched = {\n  id: crmContact.id,\n  phone: apolloData.phone_numbers?.[0] || apolloData.direct_phone || crmContact.phone,\n  position: apolloData.title || crmContact.position,\n  company_name: apolloData.organization?.name || crmContact.company_name,\n  linkedin_url: apolloData.linkedin_url,\n  twitter_url: apolloData.twitter_url,\n  enriched_at: new Date().toISOString(),\n  enrichment_source: 'apollo.io'\n};\n\nreturn [{json: enriched}];"
      },
      "id": "c1b2c3d4-0006-0006-0006-000000000006",
      "name": "Extract Apollo Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "url": "={{$env.CRM_API_URL}}/api/contacts/{{$json.id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "PATCH",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"phone\": \"{{$json.phone}}\", \"position\": \"{{$json.position}}\", \"notes\": \"Enriched via Apollo.io on {{$json.enriched_at}}\\nLinkedIn: {{$json.linkedin_url}}\\nTwitter: {{$json.twitter_url}}\"}",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('Get CRM Token').first().json}}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 2000
            }
          }
        }
      },
      "id": "c1b2c3d4-0007-0007-0007-000000000007",
      "name": "Update CRM Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "jsCode": "const enriched = $input.all().filter(i => i.json.phone).length;\nconst failed = $input.all().filter(i => !i.json.phone).length;\nconst total = $input.all().length;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow: 'Apollo Enrichment',\n    total_processed: total,\n    successfully_enriched: enriched,\n    failed: failed,\n    success_rate: total > 0 ? ((enriched / total) * 100).toFixed(2) + '%' : '0%',\n    api_credits_used: total\n  }\n}];"
      },
      "id": "c1b2c3d4-0008-0008-0008-000000000008",
      "name": "Generate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "EnrichmentLog",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{$json.timestamp}}",
            "Workflow": "={{$json.workflow}}",
            "Total": "={{$json.total_processed}}",
            "Enriched": "={{$json.successfully_enriched}}",
            "Failed": "={{$json.failed}}",
            "Success Rate": "={{$json.success_rate}}",
            "Credits Used": "={{$json.api_credits_used}}"
          }
        },
        "options": {}
      },
      "id": "c1b2c3d4-0009-0009-0009-000000000009",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2000, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "message": "=⏭️ Skipped: {{$json.email}} - Already has phone number"
      },
      "id": "c1b2c3d4-0010-0010-0010-000000000010",
      "name": "Skip - Has Phone",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Every 4 hours": {
      "main": [
        [
          {
            "node": "Get CRM Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get CRM Token": {
      "main": [
        [
          {
            "node": "Get Contacts from CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Contacts from CRM": {
      "main": [
        [
          {
            "node": "Filter: Missing Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter: Missing Phone": {
      "main": [
        [
          {
            "node": "Apollo.io Lookup",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip - Has Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apollo.io Lookup": {
      "main": [
        [
          {
            "node": "Extract Apollo Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Apollo Data": {
      "main": [
        [
          {
            "node": "Update CRM Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update CRM Contact": {
      "main": [
        [
          {
            "node": "Generate Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Report": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "CRM",
      "id": "crm-enrichment"
    },
    {
      "name": "Apollo",
      "id": "apollo-io"
    }
  ],
  "meta": {
    "instanceId": "crm-recruiting-ats"
  },
  "pinData": {},
  "versionId": "1.0.0"
}
